+@pytest.mark.parametrize("principal_id, admitted", [
+    ("participant.agent", True),
+    ("participant.foreign", False),
+])
+def test_independently_declared_principal_binding(package, principal_id, admitted):
+    raw_contract = h._contract().model_dump(mode="json")
+    raw_contract["identities"]["authorized_principal_id"] = "participant.agent"
+    contract = h.NativeParcelContract.model_validate(raw_contract)
+    assert contract.identities.authorized_principal_id != contract.identities.carrier_entity_id
+    machine = h.NativeParcelStateMachine(
+        contract=contract, run_id=h._RUN_ID, now=h._dwell_tick(0),
+    )
+    for tick in (1, 2, 3):
+        machine.observe(h._observation(package, at=h._dwell_tick(tick)))
+    action = h._action(principal_id=principal_id)
+    if admitted:
+        assert machine.admit_action(action, now=h._dwell_tick(3)).status == "admitted"
+        assert len(machine.parcel_state.transfers) == 1
+    else:
+        with pytest.raises(h.NativeParcelRuntimeError):
+            machine.admit_action(action, now=h._dwell_tick(3))
+        assert not machine.parcel_state.transfers
+
+
