+
+bool parse_positive_finite_double(const std::string& text, double& value)
+{
+    if (text.empty()) {
+        return false;
+    }
+    errno = 0;
+    char* end = nullptr;
+    value = std::strtod(text.c_str(), &end);
+    return errno == 0 && end == text.c_str() + text.size() && std::isfinite(value) &&
+           value > 0.0;
+}
+
+bool is_normalized_absolute_path(const std::string& text)
+{
+    if (text.empty() || text.front() != '/' || text.find('\0') != std::string::npos) {
+        return false;
+    }
+    const std::filesystem::path candidate{text};
+    return candidate.is_absolute() && candidate.lexically_normal().generic_string() == text;
+}
