+using SteadyClock = std::chrono::steady_clock;
+
+bool write_all(const int fd, const std::string& payload)
+{
+    std::size_t offset = 0;
+    while (offset < payload.size()) {
+        const auto* bytes = payload.data() + offset;
+        const auto remaining = payload.size() - offset;
+        const auto written = ::write(fd, bytes, remaining);
+        if (written < 0) {
+            if (errno == EINTR) {
+                continue;
+            }
+            return false;
+        }
+        if (written == 0) {
+            return false;
+        }
+        offset += static_cast<std::size_t>(written);
+    }
+    return true;
+}
+
+bool is_normalized_absolute_path(const std::string& text)
+{
+    if (text.empty() || text.front() != '/') {
+        return false;
+    }
+    if (text.find('\0') != std::string::npos) {
+        return false;
+    }
+    std::filesystem::path candidate{text};
+    return candidate.is_absolute() && candidate.lexically_normal().generic_string() == text;
+}
+
+uint64_t monotonic_timestamp_ns()
+{
+    return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                     SteadyClock::now().time_since_epoch())
+                                     .count());
+}
+
+std::string bytes_to_hex(const uint8_t* bytes, const std::size_t length)
+{
+    static constexpr char alphabet[] = "0123456789abcdef";
+    std::string encoded(length * 2, '0');
+    for (std::size_t index = 0; index < length; ++index) {
+        encoded[index * 2] = alphabet[bytes[index] >> 4];
+        encoded[index * 2 + 1] = alphabet[bytes[index] & 0x0f];
+    }
+    return encoded;
+}
+
+struct CanonicalMavlinkFrame {
+    uint16_t frame_length{};
+    uint8_t wire_version{};
+    bool signed_frame{};
+    std::string frame_hex{};
+    std::string payload_hex{};
+    std::string signature_hex{};
+};
+
+CanonicalMavlinkFrame canonical_frame(const mavlink_message_t& message)
+{
+    std::array<uint8_t, MAVLINK_MAX_PACKET_LEN> frame{};
+    const auto frame_length = mavlink_msg_to_send_buffer(frame.data(), &message);
+    const bool signed_frame =
+        message.magic == MAVLINK_STX &&
+        (message.incompat_flags & MAVLINK_IFLAG_SIGNED) != 0;
+    const auto wire_version = static_cast<uint8_t>(
+        message.magic == MAVLINK_STX ? 2 : message.magic == 0xfe ? 1 : 0);
+    return CanonicalMavlinkFrame{
+        frame_length,
+        wire_version,
+        signed_frame,
+        bytes_to_hex(frame.data(), frame_length),
+        bytes_to_hex(
+            reinterpret_cast<const uint8_t*>(_MAV_PAYLOAD(&message)), message.len),
+        signed_frame
+            ? bytes_to_hex(
+                  frame.data() + frame_length - MAVLINK_SIGNATURE_BLOCK_LEN,
+                  MAVLINK_SIGNATURE_BLOCK_LEN)
+            : ""};
+}
+
+class CommandAuditJournal {
+public:
+    static CommandAuditJournal& instance()
+    {
+        static CommandAuditJournal journal{};
+        return journal;
+    }
+
+    bool configure(const std::string& path)
+    {
+        std::lock_guard<std::mutex> lock(_mutex);
+
+        if (!is_normalized_absolute_path(path)) {
+            mavsdk::LogErrDetailed(FILENAME, __LINE__) << "Command audit journal path must be normalized and absolute";
+            return false;
+        }
+
+        if (_fd >= 0) {
+            if (_path == path) {
+                return true;
+            }
+            mavsdk::LogErrDetailed(FILENAME, __LINE__) << "Command audit journal path cannot change after configuration";
+            return false;
+        }
+
+        const int fd = ::open(
+            path.c_str(),
+            O_WRONLY | O_CREAT | O_EXCL | O_APPEND | O_CLOEXEC | O_NOFOLLOW,
+            S_IRUSR | S_IWUSR);
+        if (fd < 0) {
+            mavsdk::LogErrDetailed(FILENAME, __LINE__) << "Failed to open command audit journal";
+            return false;
+        }
+
+        struct stat st {};
+        if (::fstat(fd, &st) != 0 || !S_ISREG(st.st_mode)) {
+            mavsdk::LogErrDetailed(FILENAME, __LINE__) << "Command audit journal is not a regular file";
+            ::close(fd);
+            return false;
+        }
+
+        _fd = fd;
+        _path = path;
+        _sequence = 0;
+        return true;
+    }
+
+    bool append_transport_accept_record(
+        const mavlink_message_t& message, const uint8_t accepted_connection_count)
+    {
+        std::string_view wire_type{};
+        uint16_t command{};
+        uint8_t target_system_id{};
+        uint8_t target_component_id{};
+        uint8_t confirmation{};
+        if (message.msgid == MAVLINK_MSG_ID_COMMAND_INT) {
+            mavlink_command_int_t command_int{};
+            mavlink_msg_command_int_decode(&message, &command_int);
+            wire_type = "COMMAND_INT";
+            command = command_int.command;
+            target_system_id = command_int.target_system;
+            target_component_id = command_int.target_component;
+        } else if (message.msgid == MAVLINK_MSG_ID_COMMAND_LONG) {
+            mavlink_command_long_t command_long{};
+            mavlink_msg_command_long_decode(&message, &command_long);
+            wire_type = "COMMAND_LONG";
+            command = command_long.command;
+            target_system_id = command_long.target_system;
+            target_component_id = command_long.target_component;
+            confirmation = command_long.confirmation;
+        } else {
+            return false;
+        }
+
+        const auto frame = canonical_frame(message);
+        std::lock_guard<std::mutex> lock(_mutex);
+        return append_locked(
+            "{\"acceptance_boundary\":\"mavsdk_impl.deliver_message.connection_send_return\"",
+            ",\"accepted_connection_count\":",
+            static_cast<unsigned>(accepted_connection_count),
+            ",\"canonical_frame_hex\":\"",
+            frame.frame_hex,
+            "\",\"canonical_frame_length\":",
+            frame.frame_length,
+            ",\"checksum\":",
+            message.checksum,
+            ",\"command\":",
+            command,
+            ",\"compat_flags\":",
+            static_cast<unsigned>(message.compat_flags),
+            ",\"confirmation\":",
+            static_cast<unsigned>(confirmation),
+            ",\"frame_encoding\":\"mavlink_msg_to_send_buffer_from_packed_message\"",
+            ",\"incompat_flags\":",
+            static_cast<unsigned>(message.incompat_flags),
+            ",\"kind\":\"command_transport_accept\",\"magic\":",
+            static_cast<unsigned>(message.magic),
+            ",\"message_id\":",
+            message.msgid,
+            ",\"packet_sequence\":",
+            static_cast<unsigned>(message.seq),
+            ",\"payload_hex\":\"",
+            frame.payload_hex,
+            "\",\"payload_length\":",
+            static_cast<unsigned>(message.len),
+            ",\"seq\":",
+            next_sequence_locked(),
+            ",\"signature_hex\":\"",
+            frame.signature_hex,
+            "\",\"signed_frame\":",
+            frame.signed_frame ? "true" : "false",
+            ",\"source_component_id\":",
+            static_cast<unsigned>(message.compid),
+            ",\"source_system_id\":",
+            static_cast<unsigned>(message.sysid),
+            ",\"target_component_id\":",
+            static_cast<unsigned>(target_component_id),
+            ",\"target_system_id\":",
+            static_cast<unsigned>(target_system_id),
+            ",\"timestamp_ns\":",
+            monotonic_timestamp_ns(),
+            ",\"wire_type\":\"",
+            wire_type,
+            "\",\"wire_version\":",
+            static_cast<unsigned>(frame.wire_version),
+            "}\n");
+    }
+
+    std::optional<uint64_t> append_ack_ingress_record(
+        const mavlink_message_t& message, const mavlink_command_ack_t& command_ack)
+    {
+        const auto frame = canonical_frame(message);
+        std::lock_guard<std::mutex> lock(_mutex);
+        const auto record_sequence = next_sequence_locked();
+        if (!append_locked(
+                "{\"canonical_frame_hex\":\"",
+                frame.frame_hex,
+                "\",\"canonical_frame_length\":",
+                frame.frame_length,
+                ",\"capture_boundary\":\"mavlink_command_sender.receive_command_ack.decoded_handler\"",
+                ",\"checksum\":",
+                message.checksum,
+                ",\"command\":",
+                command_ack.command,
+                ",\"compat_flags\":",
+                static_cast<unsigned>(message.compat_flags),
+                ",\"frame_encoding\":\"mavlink_msg_to_send_buffer_from_decoded_message\"",
+                ",\"incompat_flags\":",
+                static_cast<unsigned>(message.incompat_flags),
+                ",\"kind\":\"command_ack_ingress\",\"magic\":",
+                static_cast<unsigned>(message.magic),
+                ",\"message_id\":",
+                message.msgid,
+                ",\"packet_sequence\":",
+                static_cast<unsigned>(message.seq),
+                ",\"payload_hex\":\"",
+                frame.payload_hex,
+                "\",\"payload_length\":",
+                static_cast<unsigned>(message.len),
+                ",\"progress\":",
+                static_cast<unsigned>(command_ack.progress),
+                ",\"result\":",
+                static_cast<unsigned>(command_ack.result),
+                ",\"result_param2\":",
+                command_ack.result_param2,
+                ",\"seq\":",
+                record_sequence,
+                ",\"signature_hex\":\"",
+                frame.signature_hex,
+                "\",\"signed_frame\":",
+                frame.signed_frame ? "true" : "false",
+                ",\"source_component_id\":",
+                static_cast<unsigned>(message.compid),
+                ",\"source_system_id\":",
+                static_cast<unsigned>(message.sysid),
+                ",\"target_component_id\":",
+                static_cast<unsigned>(command_ack.target_component),
+                ",\"target_system_id\":",
+                static_cast<unsigned>(command_ack.target_system),
+                ",\"timestamp_ns\":",
+                monotonic_timestamp_ns(),
+                ",\"wire_version\":",
+                static_cast<unsigned>(frame.wire_version),
+                "}\n")) {
+            return std::nullopt;
+        }
+        return record_sequence;
+    }
+
+    bool append_ack_disposition_record(
+        const uint64_t ack_ingress_seq,
+        const uint16_t command,
+        const std::string_view status)
+    {
+        std::lock_guard<std::mutex> lock(_mutex);
+        return append_locked(
+            "{\"ack_ingress_seq\":",
+            ack_ingress_seq,
+            ",\"command\":",
+            command,
+            ",\"kind\":\"command_ack_disposition\",\"seq\":",
+            next_sequence_locked(),
+            ",\"status\":\"",
+            status,
+            "\",\"timestamp_ns\":",
+            monotonic_timestamp_ns(),
+            "}\n");
+    }
+
+private:
+    template<typename... Parts> bool append_locked(const Parts&... parts)
+    {
+        if (_fd < 0) {
+            mavsdk::LogErrDetailed(FILENAME, __LINE__) << "Command audit journal is not configured";
+            return false;
+        }
+        std::ostringstream stream;
+        stream.imbue(std::locale::classic());
+        (stream << ... << parts);
+        return write_all(_fd, stream.str());
+    }
+
+    uint64_t next_sequence_locked() { return ++_sequence; }
+
+    std::mutex _mutex{};
+    int _fd{-1};
+    std::string _path{};
+    uint64_t _sequence{0};
+};
+
